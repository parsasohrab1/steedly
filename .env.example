# Settings for `docker compose up` — copy to .env and adjust.

POSTGRES_USER=steedly
POSTGRES_PASSWORD=steedly_password
POSTGRES_DB=steedly

# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# Public URLs. To use the Android test app or pay from a phone on your Wi-Fi,
# replace localhost with this computer's LAN IP (e.g. http://192.168.1.10:3000/api).
API_URL=http://localhost:3000/api
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Payments: "mock" simulates a successful payment; "zarinpal" needs a merchant id
PAYMENT_GATEWAY=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
