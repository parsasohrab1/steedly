# Server
PORT=3000
NODE_ENV=development
# Public base URL of this API (used for the payment callback and Swagger)
API_URL=http://localhost:3000/api
# Web app URL (CORS, email links, payment result page)
FRONTEND_URL=http://localhost:3001

# Database: either DATABASE_URL or the DB_* variables
# DATABASE_URL=postgresql://postgres:password@localhost:5432/steedly
DB_HOST=localhost
DB_PORT=5432
DB_NAME=steedly
DB_USER=postgres
DB_PASSWORD=

# Redis: either REDIS_URL or REDIS_HOST/REDIS_PORT
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Payments
# "mock" (default) simulates a successful payment without contacting a bank.
# "zarinpal" uses the real gateway and needs ZARINPAL_MERCHANT_ID.
PAYMENT_GATEWAY=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
# Deep-link scheme the Android app registers for payment results
ANDROID_PAYMENT_SCHEME=steedly

# Email
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Web push
PUSH_NOTIFICATIONS_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

ENABLE_SWAGGER=false
