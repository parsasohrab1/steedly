<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only: allow plain HTTP to any host so the app can reach a
    backend on the local network (Settings → server address). Release builds
    use src/main/res/xml/network_security_config.xml, which requires HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
